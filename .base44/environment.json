{
  "previewPort": 3000,
  "healthPath": "/health",
  "startCommand": "docker compose -f docker-compose.base44.yml up -d",
  "secrets": [
    { "name": "DATABASE_URL", "description": "Shared Railway Postgres (platform-provisioned)", "requiredAtBoot": true },
    { "name": "PGHOST", "description": "Shared Railway Postgres host (platform-provisioned)", "requiredAtBoot": true },
    { "name": "PGPORT", "description": "Shared Railway Postgres port (platform-provisioned)", "requiredAtBoot": true },
    { "name": "PGUSER", "description": "Shared Railway Postgres user (platform-provisioned)", "requiredAtBoot": true },
    { "name": "PGPASSWORD", "description": "Shared Railway Postgres password (platform-provisioned)", "requiredAtBoot": true },
    { "name": "PGDATABASE", "description": "Shared Railway Postgres database name (platform-provisioned)", "requiredAtBoot": true },
    { "name": "PGSSLMODE", "description": "Shared Railway Postgres SSL mode (platform-provisioned)", "requiredAtBoot": true }
  ]
}
